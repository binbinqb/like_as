# ============================================================================
#  CVM0146 · AS（AUTOSAR）框架移植
#
#  原则：**只提交能重新构建出同样镜像的源码与文档**。
#  构建产物、工具链生成物、以及靠官方渠道分发的大体积参考资料都不入库。
# ============================================================================

# ── 构建产物 ─────────────────────────────────────────────────────────────
# build/ 是 SCons 的 variant_dir，整目录都是产物（含 .exe/.map/.s19）
/build/
*.o
*.a
*.d
*.elf
*.exe
*.axf
*.s19
*.bin
*.hex
*.map
*.lst
*.crf
*.lnp
Objects/
Listings/
*.uvoptx
*.uvprojx
*.dep

# ── 工具生成 ─────────────────────────────────────────────────────────────
# tools/gen_compdb.py 生成的编译数据库，路径含本机绝对路径，换机器即失效
compile_commands.json
# SCons 的构建状态缓存（每次编译都会变，含绝对路径与时间戳）
.sconsign.dblite
.sconf_temp/
config.log

# ── 配置生成器（tools/generator）的产物 ──────────────────────────────────
# 每个 config/<模块>/GEN/ 下的 Xxx_Cfg.c/h 都是 JSON 生成的，不入库。
# 入库的是**配置源**（<模块>.json）和生成器本身 —— 这样"改了 JSON 却没提交
# 生成的 .c"这种不一致不可能发生，因为生成物根本不在版本库里。
**/GEN/

# 生成器的缓存与 PLY 解析表缓存（parsetab 由 PLY 在首次解析 DBC 时自动重建）
#
# `.gendb.pkl` 落在**仓库根目录**而不是 tools/generator/ 下 —— 因为
# generator/__init__.py 里 `RootDir = dirname(__file__) + "/../.."`，
# 对外是"配置变更检测缓存"（记 JSON 的 md5），换机器就该重建。
/.gendb.pkl
tools/generator/.gendb.pkl
# 生成门禁（tools/gen_gate.py）的本地状态：记"上次生成时输入与产物各是什么
# md5"。它描述的是**本机上一次构建**，换机器必须重算，所以不入库。
# 缺了它的效果是"下次构建重新生成一遍"，不会错，只是慢一次。
/.genstate.json
/.genstate.json.tmp
/.gendb.pkl.*.tmp
# 生成锁：App / AppB 并发构建时串行化生成，进程崩溃会留下残留（超时自动清）。
/.genlock
tools/generator/dbc/parsetab.py
tools/generator/dbc/parser.out
tools/generator/dbc/*.out
tools/generator/ldf/parsetab.py
tools/generator/ldf/parser.out
tools/generator/oil/parsetab.py
tools/generator/oil/parser.out
__pycache__/
*.pyc

# ── 参考资料：体积大，不进版本库 ─────────────────────────────────────────
# AUTOSAR 官方规范 PDF（约 356 MB）—— 从 AUTOSAR 官网获取，不随代码分发。
# 注意只排除这一个子目录：doc/AUTOSAR 学习文档/ 是自己写的东西，必须入库。
/doc/AUTOSAR-CP_R25-11官方资料/

# ── 客户（OEM）资料：不进版本库，也不得推送 ──────────────────────────────
# 下面这些是**第三方的资产**，不是本项目的代码：
#   功能规范 / 系统框图 / 通信矩阵 / 诊断数据表 / 由矩阵导出的 DBC
# 本仓库是**公开**仓库，一旦推上去就会被搜索引擎与镜像抓走，删不回来。
# 换机器需要这些输入时，从公司内部渠道取，放到同样路径即可 —— 构建与
# 生成器都只看路径，不看来源。
#
# 注：`tools/a4_gen_check.py` 在缺 DBC 时会明确报 SKIP（缺的是输入，
# 不是代码坏了），不会伪装成 PASS。
/doc/福田系统设计/
app/platform/cvm0146/src/config/dbc/*.dbc

# 厂商 SDK 副本（CVA_MCU_SDK_M01xx）与优秀开源项目参考副本（as-master 等），
# 约 562 MB，属于"外部输入"，各自有上游来源，不重复存一份。
# 真正参与编译的 SDK 在 app/platform/cvm0146/sdk/，那份是入库的。
/refs/

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
