# timer/ —— 软件定时器（与平台无关的逻辑部分）
#
# 时间源 Std_GetTime() 由平台层实现（app/platform/<chip>/src/StdTimerAc.c），
# 所以本库不需要任何额外 CPPPATH。
from building import *

CWD = GetCurrentDir()
objs = Glob("*.c")


@register_library
class LibraryStdTimer(Library):
    def config(self):
        self.CPPPATH = ["$INFRAS"]
        self.source = objs
