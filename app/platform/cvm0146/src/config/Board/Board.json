                "activeLevel": "LOW",
                "safeLevel": false
            },
            {
                "name": "HOST0",
                "source": "host",
                "channel": 0,
                "activeLevel": "HIGH",
                "safeLevel": false
            },
            {
                "name": "HOST_LOW",
                "_note": "Host 专用：低有效，验证极性在 Core 完成、Adapter 只见电气电平",
                "source": "host",
                "channel": 1,
                "activeLevel": "LOW",
                "safeLevel": false
            }
